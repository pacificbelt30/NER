# Browser URL: http://<deployment-host>:<NER_PORT>/
# NER_BIND_ADDRESS controls the Docker host's listen address, not that URL.
NER_BIND_ADDRESS=0.0.0.0
NER_PORT=8000
# Set to 1 when the browser accesses NER through HTTPS.
NER_COOKIE_SECURE=0
# Trust only the actual reverse proxy IP addresses or networks.
FORWARDED_ALLOW_IPS=127.0.0.1
